# Configuration for `docker compose up`. Copy to .env and edit.
# Everything here has a working default except the model key, so the shortest useful
# file is one line: LLM_API_KEY=...

# -- the app -------------------------------------------------------------------
# Port on the loopback interface. Change it if 7700 is taken.
APP_PORT=7700
# Image tag. Pin this to a release for anything you intend to keep; `latest` moves.
APP_VERSION=latest
# Encrypts stored connection secrets at rest. Generate with `openssl rand -hex 32`.
# Without it, adding a connection that needs a password is refused rather than stored
# in the clear.
APP_SECRET_KEY=

# -- data ----------------------------------------------------------------------
# SQLite inside the container's volume by default. Point at Postgres
# (postgres://user:pass@host:5432/db) if you outgrow it.
DB_URI=sqlite:/data/elbi.db
# Where synced warehouse tables land. A local path, or s3://, gs://, az:// for object
# storage.
STORAGE_URI=file:///data/.elbi/warehouse

# -- the model -----------------------------------------------------------------
# Any provider LiteLLM supports: `anthropic/claude-...`, `openai/gpt-...`,
# `ollama/llama3`. Leave blank and add one in Settings on first run instead.
LLM_MODEL=
LLM_API_KEY=
# For a local runtime or a gateway (e.g. http://localhost:11434 for Ollama).
LLM_BASE_URL=

# -- retention -----------------------------------------------------------------
# Days of audit history to keep (0 = keep everything).
AUDIT_RETENTION_DAYS=0

# Days a trashed artifact stays restorable before permanent erasure (0 = keep forever).
TRASH_RETENTION_DAYS=30

# -- logging -------------------------------------------------------------------
# `text` reads better in a terminal; `json` when you ship logs somewhere.
LOG_FORMAT=text
LOG_LEVEL=INFO
