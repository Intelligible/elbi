{
  "version": "0.1.1",
  "semantic_model": [
    {
      "name": "sales_semantics",
      "description": "Governed sales definitions, as an Open Semantic Interchange document.",
      "ai_context": {
        "instructions": "Revenue questions use total_amount; per-order questions use avg_amount."
      },
      "datasets": [
        {
          "name": "sales",
          "source": "sales",
          "description": "One row per order.",
          "fields": [
            {
              "name": "customer_id",
              "expression": {
                "dialects": [
                  { "dialect": "ANSI_SQL", "expression": "customer_id" }
                ]
              },
              "dimension": { "is_time": false }
            }
          ]
        }
      ],
      "metrics": [
        {
          "name": "total_amount",
          "description": "Total order value.",
          "expression": {
            "dialects": [{ "dialect": "ANSI_SQL", "expression": "SUM(amount)" }]
          }
        },
        {
          "name": "avg_amount",
          "description": "Mean order value.",
          "expression": {
            "dialects": [{ "dialect": "ANSI_SQL", "expression": "AVG(amount)" }]
          }
        }
      ]
    }
  ]
}
