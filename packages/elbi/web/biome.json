{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "!src/components/ai-elements/**",
      "!src/components/ui/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "useButtonType": "warn",
        "noLabelWithoutControl": {
          "level": "warn",
          "options": {
            "inputComponents": ["Input", "Textarea", "Select", "Switch", "Checkbox", "SourceSelect"]
          }
        },
        "noStaticElementInteractions": "warn",
        "useKeyWithClickEvents": "warn",
        "noSvgWithoutTitle": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "warn",
        "noShadowRestrictedNames": "warn",
        "noControlCharactersInRegex": "warn",
        "noAssignInExpressions": "warn"
      },
      "correctness": { "useExhaustiveDependencies": "warn" },
      "security": { "noDangerouslySetInnerHtml": "warn" },
      "complexity": { "noCommaOperator": "warn", "noImportantStyles": "warn" },
      "style": { "noNonNullAssertion": "warn" }
    }
  },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  }
}
